---
import type { Apto, TipCategory } from '../types';
import { uiAll } from '../i18n/ui';
import type { UIKey } from '../i18n/ui';
import Icon from './Icon.astro';
import T from './T.astro';

interface Props {
  apto: Apto;
}

const { apto } = Astro.props;

const iconForCategory = (cat: TipCategory): string => {
  switch (cat) {
    case 'mercado': return 'cart';
    case 'padaria': return 'bread';
    case 'restaurante': return 'fork';
    case 'oQueFazer': return 'star';
    case 'cultura': return 'museum';
    case 'lojas': return 'shop';
    case 'farmacia': return 'pill';
    default: return 'pin';
  }
};

const presentCategories = Array.from(new Set(apto.tips.map((tip) => tip.category))) as TipCategory[];
const categoryKey = (cat: TipCategory): UIKey => `tips.cat.${cat}` as UIKey;
---

<section id="dicas" class="section-anchor mx-auto max-w-6xl px-4 py-20 md:py-28">
  <div class="mb-10 text-center md:mb-14">
    <span class="eyebrow"><T text={uiAll('nav.tips')} /></span>
    <h2 class="section-title mt-2"><T text={uiAll('tips.title')} /></h2>
  </div>

  <div class="dicas-tabs mb-8 flex flex-wrap gap-2 justify-center">
    <button
      type="button"
      class="dica-tab active rounded-full bg-stone-900 px-4 py-1.5 text-sm font-medium text-white transition"
      data-cat="all"
    >
      <T text={uiAll('tips.all')} />
    </button>
    {presentCategories.map((cat) => (
      <button
        type="button"
        class="dica-tab rounded-full bg-white px-4 py-1.5 text-sm font-medium text-stone-700 ring-1 ring-stone-200 transition hover:bg-stone-100"
        data-cat={cat}
      >
        <T text={uiAll(categoryKey(cat))} />
      </button>
    ))}
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {apto.tips.map((tip) => (
      <a
        class="dica-card group relative block overflow-hidden rounded-2xl bg-white shadow-[0_2px_12px_-4px_rgba(0,0,0,0.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_-12px_rgba(0,0,0,0.22)]"
        href={`https://www.google.com/maps/search/?api=1&query=${tip.mapsQuery}`}
        target="_blank"
        rel="noopener"
        data-cat={tip.category}
      >
        <div class="relative aspect-[4/3] w-full overflow-hidden">
          <div
            class="dica-placeholder absolute inset-0 flex items-center justify-center"
            style={`background: linear-gradient(135deg, var(--apto-primary) 0%, var(--apto-accent) 100%);`}
            aria-hidden="true"
          >
            <Icon name={iconForCategory(tip.category) as any} size={64} class="text-white/30" />
          </div>

          {tip.image && (
            <img
              src={tip.image}
              alt={tip.name}
              loading="lazy"
              decoding="async"
              class="dica-img relative z-10 h-full w-full object-cover transition duration-500 group-hover:scale-105"
              onerror="this.style.display='none'"
            />
          )}

          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-1/2 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>

          <span class="absolute left-3 top-3 z-30 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-stone-800 backdrop-blur">
            <Icon name={iconForCategory(tip.category) as any} size={12} />
            <T text={uiAll(categoryKey(tip.category))} />
          </span>

          <span class="absolute right-3 top-3 z-30 rounded-full bg-black/65 px-2.5 py-1 text-[11px] font-bold text-white backdrop-blur">
            {tip.distance}
          </span>

          <p class="absolute bottom-3 left-3 right-3 z-30 line-clamp-2 font-serif text-lg font-semibold leading-tight text-white drop-shadow-sm">
            {tip.name}
          </p>
        </div>

        <div class="px-4 py-4">
          <p class="line-clamp-3 text-sm leading-relaxed text-stone-600">
            <T text={tip.description} />
          </p>
          <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold transition group-hover:gap-2.5" style={`color: var(--apto-primary)`}>
            <Icon name="maps" size={14} />
            <T text={uiAll('arrival.openMaps')} />
            <Icon name="arrow-right" size={12} />
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.dica-tab');
  const cards = document.querySelectorAll<HTMLElement>('.dica-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const cat = tab.dataset.cat;
      tabs.forEach((t) => {
        t.classList.remove('active', 'bg-stone-900', 'text-white');
        t.classList.add('bg-white', 'text-stone-700', 'ring-1', 'ring-stone-200');
      });
      tab.classList.add('active', 'bg-stone-900', 'text-white');
      tab.classList.remove('bg-white', 'text-stone-700', 'ring-1', 'ring-stone-200');

      cards.forEach((card) => {
        if (cat === 'all' || card.dataset.cat === cat) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
