---
import type { Apto, Lang } from '../types';
import { uiAll } from '../i18n/ui';
import Icon from './Icon.astro';
import T from './T.astro';

interface Props {
  apto: Apto;
}

const { apto } = Astro.props;

const langs: Lang[] = ['pt', 'en', 'es'];
const waLabel = uiAll('contact.whatsapp');

const buildWaUrl = (lang: Lang) => {
  const msg = encodeURIComponent(apto.contact.whatsappMessage[lang]);
  return `https://wa.me/${apto.contact.hostPhone}?text=${msg}`;
};
---

<section id="contato" class="section-anchor mx-auto max-w-6xl px-4 py-20 md:py-28">
  <div class="mb-10 text-center md:mb-14">
    <span class="eyebrow"><T text={uiAll('nav.contact')} /></span>
    <h2 class="section-title mt-2"><T text={uiAll('contact.title')} /></h2>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <div class="card card-hover flex flex-col items-center text-center md:items-start md:text-left">
      <div
        class="flex h-20 w-20 items-center justify-center rounded-full text-3xl font-serif font-bold text-white"
        style={`background: var(--apto-primary)`}
      >
        {apto.contact.hostPhotoInitial}
      </div>
      <p class="mt-4 text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">
        <T text={uiAll('contact.host')} />
      </p>
      <p class="mt-1 font-serif text-2xl font-semibold text-stone-900">
        {apto.contact.hostName}
      </p>
      <div class="mt-6">
        {langs.map((l) => (
          <a
            href={buildWaUrl(l)}
            target="_blank"
            rel="noopener"
            data-lang-only={l}
            class="items-center gap-2 rounded-full bg-[#25d366] px-5 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
          >
            <Icon name="whatsapp" size={16} />
            <span>{waLabel[l]}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="card">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">
        <T text={uiAll('contact.emergency')} />
      </p>
      <ul class="mt-4 divide-y divide-stone-100">
        <li class="flex items-center justify-between py-3">
          <span class="font-medium text-stone-800"><T text={uiAll('contact.police')} /></span>
          <a
            href={`tel:${apto.emergency.police}`}
            class="flex items-center gap-2 rounded-full bg-stone-100 px-3.5 py-1.5 font-mono text-sm font-bold text-stone-900 transition hover:bg-stone-200"
          >
            <Icon name="phone" size={14} />
            {apto.emergency.police}
          </a>
        </li>
        <li class="flex items-center justify-between py-3">
          <span class="font-medium text-stone-800"><T text={uiAll('contact.samu')} /></span>
          <a
            href={`tel:${apto.emergency.samu}`}
            class="flex items-center gap-2 rounded-full bg-stone-100 px-3.5 py-1.5 font-mono text-sm font-bold text-stone-900 transition hover:bg-stone-200"
          >
            <Icon name="phone" size={14} />
            {apto.emergency.samu}
          </a>
        </li>
        <li class="flex items-center justify-between py-3">
          <span class="font-medium text-stone-800"><T text={uiAll('contact.firefighters')} /></span>
          <a
            href={`tel:${apto.emergency.firefighters}`}
            class="flex items-center gap-2 rounded-full bg-stone-100 px-3.5 py-1.5 font-mono text-sm font-bold text-stone-900 transition hover:bg-stone-200"
          >
            <Icon name="phone" size={14} />
            {apto.emergency.firefighters}
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
