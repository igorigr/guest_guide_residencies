---
import '../styles/global.css';
import { aptos } from '../data/aptos';
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Guest Guides</title>
    <style>
      body {
        background: linear-gradient(135deg, #1a1410 0%, #2f1c0d 100%);
        color: white;
        min-height: 100vh;
        font-family: 'Inter', system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="font-sans">
    <main class="mx-auto max-w-4xl px-6 py-20">
      <header class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-400">
          Internal • Hosts only
        </p>
        <h1
          class="mt-3 font-serif text-5xl font-semibold tracking-tight text-white sm:text-6xl"
          style="font-family: 'Playfair Display', serif;"
        >
          Guias do Hóspede
        </h1>
        <p class="mx-auto mt-4 max-w-md text-base text-stone-300">
          Selecione o apartamento para ver o guia.
        </p>
      </header>

      <section class="mt-14 grid gap-4 sm:grid-cols-2">
        {aptos.map((apto) => (
          <a
            href={`/${apto.slug}`}
            class="group relative flex items-center gap-4 overflow-hidden rounded-2xl bg-white/5 p-5 ring-1 ring-white/10 backdrop-blur transition hover:bg-white/10 hover:ring-white/20"
          >
            <span
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-base font-bold text-white"
              style={`background: ${apto.theme?.primary ?? '#7c5e3c'}`}
            >
              {apto.shortName.replace(/\D/g, '').slice(-3) || apto.shortName.charAt(0)}
            </span>
            <div class="flex-1">
              <p class="font-semibold text-white">{apto.name}</p>
              <p class="text-xs uppercase tracking-wider text-stone-400">
                {apto.location.city} • {apto.location.state}
              </p>
              <p class="mt-1 truncate text-xs text-stone-400">/{apto.slug}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-400 transition group-hover:translate-x-1 group-hover:text-white">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        ))}
      </section>

      <footer class="mt-16 text-center text-xs text-stone-500">
        <p>Disponível em PT • EN • ES (selecionável dentro do guia)</p>
      </footer>
    </main>
  </body>
</html>
