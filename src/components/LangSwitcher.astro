---
import type { Lang } from '../types';
import { languages } from '../i18n/ui';

const flags: Record<Lang, { label: string; aria: string }> = {
  pt: { label: 'Português', aria: 'Mudar para Português' },
  en: { label: 'English', aria: 'Switch to English' },
  es: { label: 'Español', aria: 'Cambiar a Español' },
};
---

<div
  class="lang-switcher flex items-center gap-1 rounded-full bg-white/70 p-1 backdrop-blur-md ring-1 ring-black/5"
  role="group"
  aria-label="Language"
>
  {(Object.keys(languages) as Lang[]).map((lang) => (
    <button
      type="button"
      data-set-lang={lang}
      aria-label={flags[lang].aria}
      title={flags[lang].label}
      class="lang-flag relative flex h-9 w-9 cursor-pointer items-center justify-center overflow-hidden rounded-full transition focus:outline-none"
    >
      {lang === 'pt' && (
        <svg viewBox="0 0 30 21" class="h-full w-full" aria-hidden="true">
          <rect width="30" height="21" fill="#009b3a" />
          <polygon points="15,2.5 27.5,10.5 15,18.5 2.5,10.5" fill="#fedf00" />
          <circle cx="15" cy="10.5" r="4.5" fill="#002776" />
          <path
            d="M11 11.6 a4.5 4.5 0 0 1 8 -0.8"
            stroke="#fff"
            stroke-width="0.6"
            fill="none"
          />
        </svg>
      )}
      {lang === 'en' && (
        <svg viewBox="0 0 60 30" class="h-full w-full" aria-hidden="true">
          <clipPath id="uk-clip">
            <rect width="60" height="30" />
          </clipPath>
          <g clip-path="url(#uk-clip)">
            <rect width="60" height="30" fill="#012169" />
            <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
            <path d="M0,0 L60,30 M60,0 L0,30" stroke="#c8102e" stroke-width="2" />
            <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10" />
            <path d="M30,0 V30 M0,15 H60" stroke="#c8102e" stroke-width="6" />
          </g>
        </svg>
      )}
      {lang === 'es' && (
        <svg viewBox="0 0 30 21" class="h-full w-full" aria-hidden="true">
          <rect width="30" height="21" fill="#aa151b" />
          <rect width="30" height="10.5" y="5.25" fill="#f1bf00" />
        </svg>
      )}
      <span class="sr-only">{flags[lang].label}</span>
    </button>
  ))}
</div>

<style is:global>
  .lang-flag {
    opacity: 0.55;
    transform: scale(1);
  }
  .lang-flag:hover {
    opacity: 1;
    transform: scale(1.05);
  }
  html[data-lang='pt'] .lang-flag[data-set-lang='pt'],
  html[data-lang='en'] .lang-flag[data-set-lang='en'],
  html[data-lang='es'] .lang-flag[data-set-lang='es'] {
    opacity: 1;
    transform: scale(1.1);
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--apto-primary);
  }
</style>
