---
import type { Apto } from '../types';
import { uiAll } from '../i18n/ui';
import T from './T.astro';

interface Props {
  apto: Apto;
}

const { apto } = Astro.props;
const locationMap = apto.locationMap;

if (!locationMap) return null;
---

<section id="localizacao" class="section-anchor mx-auto max-w-6xl px-4 py-20 md:py-28">
  <div class="mb-10 text-center md:mb-14">
    <span class="eyebrow"><T text={uiAll('nav.localizacao')} /></span>
    <h2 class="section-title mt-2"><T text={uiAll('localizacao.title')} /></h2>
    {locationMap.subtitle && (
      <p class="mx-auto mt-3 max-w-2xl text-sm text-stone-600">
        <T text={locationMap.subtitle} />
      </p>
    )}
  </div>

  <figure class="card mx-auto max-w-5xl overflow-hidden p-0">
    <img
      src={locationMap.image}
      alt={apto.name}
      class="h-auto w-full"
      loading="lazy"
      decoding="async"
    />
  </figure>
</section>
